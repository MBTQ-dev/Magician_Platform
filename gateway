import { serve } from "https://deno.land/std@0.192.0/http/server.ts";

const port = 8000;

const handler = async (request: Request): Response => {
  const url = new URL(request.url);
  const path = url.pathname;

  if (path === "/health") {
    return new Response(JSON.stringify({ status: "ok", service: "deno-api" }), {
      headers: { "content-type": "application/json" },
    });
  }

  // Proxy to microservices
  if (path.startsWith("/api/auth")) {
    return await fetch(`http://deafauth:3001${path.replace("/api/auth", "")}`, {
      method: request.method,
      headers: request.headers,
      body: request.body,
    });
  }

  if (path.startsWith("/api/sync")) {
    return await fetch(`http://pinksync:3002${path.replace("/api/sync", "")}`, {
      method: request.method,
      headers: request.headers,
      body: request.body,
    });
  }

  if (path.startsWith("/api/a11y")) {
    return await fetch(`http://accessibility:3003${path.replace("/api/a11y", "")}`, {
      method: request.method,
      headers: request.headers,
      body: request.body,
    });
  }

  const body = JSON.stringify({
    service: "deno-api",
    status: "online",
    message: "Welcome to the MBTQ Universe Gateway",
    endpoints: ["/api/auth", "/api/sync", "/api/a11y"]
  });

  return new Response(body, {
    status: 200,
    headers: {
      "content-type": "application/json",
    },
  });
};

console.log(`Deno API listening at http://localhost:${port}`);
serve(handler, { port });
